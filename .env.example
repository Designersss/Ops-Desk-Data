# Local development: docker compose up -d
# PostgreSQL проекта PBS доступен на порту хоста 55432 (порт контейнера 5432)
PBS_DB_PORT=55432
DATABASE_URL=postgresql://pbs:pbs_local@127.0.0.1:55432/pbs
# Set to a long random string for deployment; never commit real secrets
SESSION_SECRET=replace-with-a-random-64-character-secret-before-deploying
# In production all four PINs are required to switch roles
DIRECTOR_PIN=
PREPARATION_PIN=
WELDING_PIN=
DOCUMENTS_PIN=
